# API Configuration
# Required: Set your API authentication token
# ANTHROPIC_AUTH_TOKEN=your_api_key_here

# # Optional: Custom API endpoint
# ANTHROPIC_BASE_URL=https://openrouter.ai/api

# # Optional: Model selection
# CLAUDE_MODEL=anthropic/claude-sonnet-4.5

# Optional: Custom Claude Code CLI path
# IMPORTANT: Use forward slashes (/) on Windows, not backslashes (\)
# CLAUDE_CODE_PATH=C:/Users/yourname/AppData/Roaming/npm/node_modules/@anthropic-ai/claude-code/cli.js

# ── Google Workspace OAuth (bundled credentials) ──────────────────────────────
# Set these to bundle your Google OAuth app credentials into dsr-CoworkAI so
# users see a one-click "Sign in with Google" button instead of a credential
# form. Obtain these from Google Cloud Console:
#   1. Go to https://console.cloud.google.com/
#   2. Create a project (e.g. "dsr-CoworkAI")
#   3. Enable APIs: Gmail API, Google Drive API, Google Calendar API, People API
#   4. OAuth consent screen → External → add scopes:
#        gmail.readonly  drive.readonly  calendar.readonly  openid  email
#   5. Credentials → Create → OAuth client ID → Desktop app
#   6. Copy the Client ID and Client Secret below
#   7. Add authorized redirect URIs: http://127.0.0.1 (loopback for desktop OAuth)
#
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-your-client-secret
